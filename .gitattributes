# Normalize line endings: the repo always stores LF, even when working on
# Windows. Without this, CRLF breaks shell scripts and pollutes every diff.
* text=auto eol=lf

*.sql   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf

# Binaries: never touched
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary
